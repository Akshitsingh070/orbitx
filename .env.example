# === AI ===
# OpenRouter is the primary AI provider (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Any OpenRouter model id; :free variants cost nothing
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional fallback provider (Google AI Studio key)
GEMINI_API_KEY=

# === GitHub OAuth ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Notion ===
NOTION_TOKEN=

# === Neo4j AuraDB ===
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# === Auth ===
JWT_SECRET=your-secret-here

# === Demo Mode ===
# Set to true to run with mock data (no API keys needed)
DEMO_MODE=true

# === Frontend API URL ===
NEXT_PUBLIC_API_URL=http://localhost:8000
